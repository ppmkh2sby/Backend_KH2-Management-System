{
  "ApplicationMetadata": {
    "Name": "KH2 Management System API",
    "Version": "v1"
  },
  "Jwt": {
    "Issuer": "https://api.example.com",
    "Audience": "https://app.example.com",
    "SecretKey": "REPLACE_WITH_A_LONG_RANDOM_SECRET_MIN_32_CHARS",
    "AccessTokenLifetimeMinutes": 60,
    "RefreshTokenLifetimeDays": 7
  },
  "ConnectionStrings": {
    "DefaultConnection": "Host=REPLACE_WITH_DATABASE_HOST;Port=5432;Database=postgres;Username=REPLACE_WITH_DATABASE_USER;Password=REPLACE_WITH_DATABASE_PASSWORD;SSL Mode=Require;Trust Server Certificate=true"
  },
  "Cors": {
    "AllowedOrigins": []
  },
  "ReverseProxy": {
    "ForwardLimit": 1,
    "KnownProxies": [
      "127.0.0.1",
      "::1"
    ],
    "KnownNetworks": []
  },
  "Database": {
    "MigrateOnStartup": false,
    "SeedOnStartup": false,
    "SeedSampleDataOnStartup": false
  },
  "FaceRecognition": {
    "BaseUrl": "http://face-recognition.internal/",
    "ApiKey": "REPLACE_WITH_A_RANDOM_SECRET_MIN_32_CHARS",
    "SimilarityThreshold": null,
    "TimeoutSeconds": 15,
    "ExpectedEmbeddingDimension": 512,
    "RequiredEnrollmentSamples": 5
  },
  "LegacyFaceProvider": {
    "BaseUrl": "http://legacy-face-provider.internal/",
    "ApiKey": "REPLACE_WITH_A_RANDOM_SECRET_MIN_32_CHARS",
    "ConfidenceThreshold": 0.60,
    "TimeoutSeconds": 15,
    "CaptureStoragePath": "/var/lib/kh2/private-face-captures"
  },
  "LegacyFaceApi": {
    "Enabled": true
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "api.example.com"
}
